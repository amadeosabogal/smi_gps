# Copia este archivo a service/.env y completa los valores. NUNCA subas .env a git.
NODE_ENV=production
PORT=3001

# --- Base de datos SQL Server ---
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=GPS_SMI
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- Seguridad ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FACE_MATCH_THRESHOLD=0.58
# Intentos de login fallidos permitidos por IP cada 10 min (toda una planta comparte IP; el límite por usuario protege cada cuenta)
LOGIN_IP_MAX=60
# Días que se conservan los puntos GPS del recorrido (mínimo 7). Vacío o 0 = no borrar nunca.
RETENCION_UBICACIONES_DIAS=
# Notificaciones push (alertas al celular). Genera las claves con: npm run vapid
# Usa una pareja distinta en desarrollo y en producción. La clave privada es un SECRETO.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@tuempresa.com
# Precisión GPS exigida, en metros: para marcar entrada y para los puntos durante el turno
GPS_MAX_ACCURACY_CHECKIN_M=50
GPS_MAX_ACCURACY_PING_M=100
SESSION_HOURS=12
ADMIN_SESSION_HOURS=8
# Archivo con la última versión de la app Android (lo lee GET /api/app/version; ver DESPLIEGUE.md)
ANDROID_VERSION_FILE=/var/www/smi_descargas/version.json
# Almuerzo dentro del turno: minutos permitidos y cuántos almuerzos por turno (el GPS sigue activo durante el almuerzo)
ALMUERZO_MINUTOS=60
ALMUERZOS_POR_TURNO=1
# Minutos sin recibir ubicación de un trabajador en turno antes de avisar al administrador (alerta "Sin señal GPS en turno").
# Mínimo 2; 0 = no avisar. Además, la app Android avisa al instante si el trabajador apaga la ubicación del celular.
SIN_SENAL_ALERTA_MIN=5
# Zona horaria que decide qué día es "hoy" para el calendario de días no laborables (feriados)
BUSINESS_TZ=America/Lima
# Marca de esta instalación: nombre que se muestra en las alertas al celular (vacío = SMI).
# La web usa VITE_BRAND_NAME en client/.env (antes de compilar). Con marca propia se muestra el nombre como texto en lugar del logo.
BRAND_NAME=
# true = el trabajador SOLO ingresa con DNI y contraseña (npm run migrate-dni y DNI cargado a cada trabajador).
# Apaga el ingreso antiguo por nombre y la lista pública de nombres. Activar cuando todos tengan la app nueva.
LOGIN_SOLO_DNI=false
# Plazos de conservación de datos personales, en días (vacío = no borrar nunca; mínimo 30). Se aplican solos cada 24 h.
#   FOTOS: borra las fotos de verificación (la asistencia se conserva) · REGISTROS: borra asistencias terminadas, alertas y avisos
RETENCION_FOTOS_DIAS=
RETENCION_REGISTROS_DIAS=
# Aviso de privacidad dentro de la app (npm run migrate-privacidad). Los datos de la empresa se muestran al trabajador.
EMPRESA_NOMBRE=
EMPRESA_RUC=
EMPRESA_DOMICILIO=
EMPRESA_CORREO_DATOS=
EMPRESA_PROVEEDOR=
EMPRESA_PAIS_SERVIDOR=
EMPRESA_ALTERNATIVA_SIN_AUTORIZACION=
EMPRESA_DIAS_ROSTRO_TRAS_CESE=30
# true = el trabajador DEBE aceptar el aviso antes de usar la app (activar cuando todos tengan la app 1.0.5 o la web nueva)
EXIGIR_ACEPTACION_PRIVACIDAD=false
PRIVACIDAD_VERSION=1
# Vigencia (horas) del token de rastreo de la app Android (solo sirve para enviar ubicaciones del turno activo)
TRACK_TOKEN_HOURS=18

# --- Red / producción ---
# Orígenes permitidos para CORS y WebSocket, separados por coma (vacío = solo mismo origen).
# Ejemplo: https://asistencia.tuempresa.com
# Si usas la app Android (Capacitor), añade también https://localhost (origen de su WebView):
#   CORS_ORIGINS=https://asistencia.tuempresa.com,https://localhost
CORS_ORIGINS=
# Pon 1 si hay un proxy inverso (nginx, Caddy, Cloudflare) delante del servidor
TRUST_PROXY=
# TLS directo en Node (alternativa a un proxy). La cámara y el GPS del celular EXIGEN HTTPS.
SSL_KEY_PATH=
SSL_CERT_PATH=
