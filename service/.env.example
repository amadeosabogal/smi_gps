# Copia este archivo a service/.env y completa los valores. NUNCA subas .env a git.
NODE_ENV=production
PORT=3001

# --- Base de datos SQL Server ---
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=GPS_SMI
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- Seguridad ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FACE_MATCH_THRESHOLD=0.58
# Intentos de login fallidos permitidos por IP cada 10 min (toda una planta comparte IP; el límite por usuario protege cada cuenta)
LOGIN_IP_MAX=60
SESSION_HOURS=12
ADMIN_SESSION_HOURS=8

# --- Red / producción ---
# Orígenes permitidos para CORS y WebSocket, separados por coma (vacío = solo mismo origen).
# Ejemplo: https://asistencia.tuempresa.com
CORS_ORIGINS=
# Pon 1 si hay un proxy inverso (nginx, Caddy, Cloudflare) delante del servidor
TRUST_PROXY=
# TLS directo en Node (alternativa a un proxy). La cámara y el GPS del celular EXIGEN HTTPS.
SSL_KEY_PATH=
SSL_CERT_PATH=
