# Google Maps Official JavaScript API Key
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...
# Nombre de la marca de esta instalación (vacío = SMI con su logo). Con valor, se muestra como texto en lugar del logo.
VITE_BRAND_NAME=


# Solo para pruebas de geocerca en interiores: muestra botones de "Simular movimiento". Dejar apagado en producción.
# VITE_ENABLE_SIMULATION=true

# Solo para la app móvil (Capacitor): URL pública del backend, ej. https://asistencia.tuempresa.com
# VITE_API_BASE_URL=
